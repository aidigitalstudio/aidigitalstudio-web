---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header       from '../components/Header.astro';
import Hero         from '../components/Hero.astro';
import Nosotras     from '../components/Nosotras.astro';
import Servicios    from '../components/Servicios.astro';
import Proceso      from '../components/Proceso.astro';
import Proyectos    from '../components/Proyectos.astro';
import PorQueAI     from '../components/PorQueAI.astro';
import Contacto     from '../components/Contacto.astro';
import Footer       from '../components/Footer.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
---

<Layout
  title="A&I Digital Studio | Diseño web para pequeños negocios en Panamá"
  description="Diseñamos páginas web funcionales y presencia digital para pequeños negocios en Panamá, con cotización directa y acompañamiento cercano."
>
  <Header />

  <a class="skip-link" href="#main-content">Saltar al contenido</a>
  <main id="main-content">
    <Hero />
    <Nosotras />
    <Servicios />
    <Proceso />
    <Proyectos />
    <PorQueAI />
    <Contacto />
  </main>

  <Footer />
  <BotonWhatsApp />
</Layout>
