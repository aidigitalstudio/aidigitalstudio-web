---
import { whatsappUrl, whatsappNumero, correo, instagram, instagramUrl } from '../data/site';
const preguntas = [
 { pregunta: '¿Cuánto cuesta una página web?', respuesta: 'Cada proyecto se cotiza según lo que tu negocio necesita; escríbenos por WhatsApp y te orientamos sin compromiso.' },
 { pregunta: '¿Qué tipo de página necesito para empezar?', respuesta: 'Desde una página esencial de una sola vista hasta un sitio informativo con varias secciones.' },
 { pregunta: '¿Se verá bien en celulares y tendrá botón de WhatsApp?', respuesta: 'Sí, todas las páginas se diseñan pensando primero en celular y con contacto directo a tu WhatsApp.' },
 { pregunta: '¿Puedo pedir cambios antes de publicar?', respuesta: 'Sí, revisas la propuesta y ajustamos los detalles antes del lanzamiento.' },
];
---
<section id="preguntas" class="section faq-section bg-blanco" aria-labelledby="faq-heading">
 <div class="container faq-grid">
  <header><span class="section-label reveal">Preguntas frecuentes</span><h2 id="faq-heading" class="section-title reveal delay-100">Antes de empezar</h2><p class="section-subtitle reveal delay-200">Respuestas claras para que sepas qué esperar del proceso.</p></header>
 <div class="faq-list">{preguntas.map((item,i)=><details class={`faq-item reveal delay-${Math.min((i+1)*100,300)}`}><summary><span>{item.pregunta}</span><b aria-hidden="true">+</b></summary><div class="faq-answer"><div class="faq-answer-inner"><p class="font-texto text-carbon-suave">{item.respuesta}</p></div></div></details>)}</div>
 </div>
</section>
<section id="contacto" class="section bg-blanco contact-section" aria-labelledby="contacto-heading">
 <div class="container contact-wrap">
  <div class="contact-copy"><span class="section-label reveal">Contacto</span><h2 id="contacto-heading" class="section-title reveal delay-100">Cuéntanos sobre tu negocio.</h2><p class="font-titulo reveal delay-150" style="font-size:1rem;font-weight:700;color:var(--color-turquesa-oscuro);margin-bottom:.5rem;">¿Tu negocio todavía no tiene página web? Conversemos sin compromiso.</p><p class="font-texto text-carbon-suave reveal delay-200">Escríbenos por WhatsApp para conversar sobre lo que necesitas y los próximos pasos.</p>
   <div class="contact-cta reveal delay-300"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-naranja" aria-label={`Escribirnos por WhatsApp al ${whatsappNumero}`}>Escribirnos por WhatsApp <span aria-hidden="true">↗</span></a><p class="font-texto text-carbon-suave"><strong>{whatsappNumero}</strong><span>Solo WhatsApp · no llamadas</span></p></div>
  </div>
  <div class="contact-card reveal delay-200"><span class="card-kicker">También puedes encontrarnos aquí</span><a href={`mailto:${correo}`} class="contact-link" aria-label={`Escribirnos al correo ${correo}`}><span class="contact-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span><small>Correo</small><b>{correo}</b></span><span class="link-arrow" aria-hidden="true">↗</span></a><a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="contact-link" aria-label={`Encontrarnos en Instagram ${instagram}`}><span class="contact-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg></span><span><small>Instagram</small><b>{instagram}</b></span><span class="link-arrow" aria-hidden="true">↗</span></a></div>
 </div>
</section>
<style>
.faq-section{padding-bottom:3rem}.faq-grid{display:grid;grid-template-columns:1fr;gap:2rem}.faq-grid header{max-width:360px}.faq-list{border-top:1px solid #e5e5e5}.faq-item{border-bottom:1px solid #e5e5e5}.faq-item summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.15rem .1rem;list-style:none;cursor:pointer;font:650 .98rem var(--font-titulo);color:var(--color-carbon)}.faq-item summary::-webkit-details-marker{display:none}.faq-item summary b{flex:none;width:1.7rem;height:1.7rem;display:grid;place-items:center;border-radius:50%;background:#e9f5f2;color:#176f6f;font-size:1rem;transition:transform .2s ease}.faq-item[open] summary b{transform:rotate(45deg)}.faq-answer{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .25s ease,opacity .25s ease}.faq-answer-inner{overflow:hidden}.faq-item[open] .faq-answer{grid-template-rows:1fr;opacity:1}.faq-answer p{padding:0 2.7rem 1.1rem .1rem;font-size:.9rem;line-height:1.75}.contact-section{padding-top:3rem}.contact-wrap{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr;gap:2rem;padding:clamp(1.5rem,5vw,3.5rem);border:1px solid #e5e5e5;border-radius:1.25rem;background:linear-gradient(125deg,#fff 55%,#f0f8f6)}.contact-copy{max-width:490px}.contact-copy .section-title{margin-bottom:.9rem}.contact-copy>p{font-size:1rem;line-height:1.75}.contact-cta{margin-top:1.5rem}.contact-cta p{display:flex;flex-direction:column;margin:.75rem 0 0 .2rem;font-size:.83rem;line-height:1.55}.contact-cta p strong{font-weight:700;color:var(--color-carbon)}.contact-cta p span{font-size:.75rem;color:#4a4a4a}.contact-card{align-self:center;border:1px solid #e5e5e5;border-radius:.9rem;padding:.4rem 1.15rem;background:#fff}.card-kicker{display:block;padding:1rem .15rem .65rem;font:700 .65rem var(--font-titulo);letter-spacing:.08em;text-transform:uppercase;color:#176f6f}.contact-link{display:flex;align-items:center;gap:.8rem;padding:.85rem .15rem;border-top:1px solid #edf0ef;color:var(--color-carbon)}.contact-icon{width:2.25rem;height:2.25rem;flex:none;display:grid;place-items:center;border-radius:.65rem;background:#e9f5f2;color:#176f6f;font:700 1.1rem var(--font-titulo)}.contact-link>span:nth-child(2){display:flex;min-width:0;flex-direction:column;gap:.1rem}.contact-link small{font:600 .68rem var(--font-titulo);color:#65716e}.contact-link b{font:650 .88rem var(--font-texto);overflow-wrap:anywhere}.link-arrow{margin-left:auto;color:#176f6f}.contact-link:hover b,.contact-link:focus-visible b{color:#176f6f}
@media(min-width:800px){.faq-grid{grid-template-columns:.75fr 1.25fr;gap:4rem}.faq-section{padding-bottom:4rem}.contact-wrap{grid-template-columns:1fr .8fr;gap:4rem;align-items:center}.contact-section{padding-top:4rem}}
@media(max-width:380px){.contact-wrap{padding:1.2rem}.contact-card{padding-inline:.8rem}.contact-link{gap:.55rem}.contact-link b{font-size:.78rem}}
</style>
