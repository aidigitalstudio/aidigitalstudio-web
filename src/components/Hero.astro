---
// src/components/Hero.astro
import { whatsappUrl } from '../data/site';
---

<section
  id="inicio"
  class="bg-blanco section"
  style="padding-top: 6rem; padding-bottom: 6rem; min-height: 90vh; display: flex; align-items: center;"
  aria-labelledby="hero-heading"
>
  <div
    class="container"
    style="display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center;"
  >
    <!-- Texto principal -->
    <div style="max-width: 640px;">
      <span class="section-label reveal">Estudio de desarrollo web · Panamá</span>

      <h1
        id="hero-heading"
        class="font-titulo text-carbon reveal delay-100"
        style="font-size: clamp(2rem, 5.5vw, 3.25rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.5rem;"
      >
        Tu negocio merece verse<br />
        <span style="color: var(--color-turquesa);">tan profesional</span><br />
        como realmente es.
      </h1>

      <p
        class="font-texto text-carbon-suave reveal delay-200"
        style="font-size: 1.125rem; line-height: 1.75; margin-bottom: 2.5rem; max-width: 520px;"
      >
        Diseñamos páginas web y presencia digital para pequeños negocios
        en Panamá. Sin tecnicismos, sin sorpresas, con resultados reales.
      </p>

      <div
        class="reveal delay-300"
        style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;"
      >
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-naranja"
          aria-label="Solicitar cotización por WhatsApp"
        >
          <!-- Ícono WhatsApp -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.112.546 4.1 1.5 5.832L0 24l6.336-1.46A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.014-1.376l-.359-.214-3.754.865.898-3.646-.234-.374A9.818 9.818 0 0112 2.182c5.42 0 9.818 4.398 9.818 9.818 0 5.421-4.398 9.818-9.818 9.818z"/>
          </svg>
          Solicitar cotización
        </a>

        <a
          href="#nosotras"
          class="btn btn-outline"
          aria-label="Conocer más sobre nosotras"
        >
          Conócenos
        </a>
      </div>
    </div>

    <!-- Elemento decorativo (lado derecho en desktop) -->
    <div
      class="reveal delay-200"
      aria-hidden="true"
      style="display: none;"
    >
      <!-- Espacio para ilustración o foto de equipo -->
    </div>
  </div>

  <!-- Acento decorativo de fondo -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      top: 0; right: 0;
      width: min(50vw, 500px);
      height: 100%;
      background: linear-gradient(135deg, rgba(43,191,191,0.07) 0%, rgba(43,191,191,0) 70%);
      pointer-events: none;
      z-index: 0;
    "
  ></div>
</section>

<style>
  section { position: relative; overflow: hidden; }

  @media (min-width: 900px) {
    .container {
      grid-template-columns: 1fr 1fr !important;
    }
    div[aria-hidden="true"] {
      display: block !important;
    }
  }
</style>

