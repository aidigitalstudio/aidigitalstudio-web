---
import { whatsappUrl } from '../data/site';
---
<section id="inicio" class="hero bg-blanco" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="availability reveal"><span class="availability-dot" aria-hidden="true"></span><span>Disponible para negocios en Panamá</span></div>
      <h1 id="hero-heading" class="font-titulo text-carbon reveal delay-100">Tu negocio merece verse tan profesional como realmente es.</h1>
      <p class="font-texto text-carbon-suave reveal delay-200">Diseñamos páginas web rápidas, funcionales y adaptadas a celular para pequeños negocios en Panamá. Sin tecnicismos ni mensualidades ocultas.</p>
      <div class="hero-actions reveal delay-300">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-naranja">Solicitar cotización <span aria-hidden="true">↗</span></a>
        <a href="#proyectos" class="secondary-link">Ver proyectos <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-note font-texto text-carbon-suave">Diseñado en Panamá para negocios panameños.</p>
    </div>
    <div class="studio-window reveal delay-200" role="img" aria-label="Mockup ilustrativo de una página web para un negocio local">
      <div class="window-top"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>vista de proyecto</span><span class="window-mark">A&amp;I</span></div>
      <div class="window-page">
        <div class="page-nav"><b>tu marca</b><div><i></i><i></i><i></i></div><span>Contacto</span></div>
        <div class="page-main"><div class="page-copy"><small>HECHO PARA TU NEGOCIO</small><strong>Lo que haces,<br/><em>bien contado.</em></strong><p>Una presencia digital sencilla y clara para tus clientes.</p><span class="page-cta">Conoce más <b>→</b></span></div><div class="page-visual" aria-hidden="true"><div class="visual-sun"></div><div class="visual-building"><i></i><i></i><i></i></div><div class="visual-ground"></div></div></div>
        <div class="page-bottom"><span></span><span></span><span></span></div>
      </div>
      <div class="window-caption"><span>Diseño adaptable</span><span>·</span><span>Contenido claro</span></div>
    </div>
  </div>
</section>
<style>
.availability{display:flex;align-items:center;gap:.55rem;color:#176f6f;font:700 .75rem var(--font-titulo);letter-spacing:.015em}.availability-dot{position:relative;width:.55rem;height:.55rem;flex:none;border-radius:50%;background:#43bad0}.availability-dot::after{content:"";position:absolute;inset:-.2rem;border:1px solid #43bad0;border-radius:50%;animation:availability-pulse 2.2s ease-out infinite}@keyframes availability-pulse{0%{transform:scale(.7);opacity:.8}100%{transform:scale(1.8);opacity:0}}.page-cta{color:#fff}
.hero{padding:clamp(4rem,9vw,7.5rem) 1.25rem 6rem;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1fr;gap:3.25rem;align-items:center}.hero-copy{max-width:590px}.hero h1{font-size:clamp(2.45rem,6vw,4.35rem);font-weight:700;letter-spacing:-.05em;line-height:1.07;margin:1.1rem 0 1.4rem;max-width:13ch}.hero-copy>p:not(.hero-note){font-size:1.08rem;line-height:1.8;max-width:500px;margin-bottom:1.7rem}.hero-actions{display:flex;align-items:center;gap:1.4rem;flex-wrap:wrap}.secondary-link{font-family:var(--font-titulo);font-size:.92rem;font-weight:700;color:var(--color-carbon);padding:.7rem 0}.secondary-link span{color:var(--color-turquesa-oscuro);margin-left:.3rem}.hero-note{font-size:.82rem;margin-top:1.5rem}.studio-window{width:100%;max-width:560px;justify-self:center;border:1px solid #e5e5e5;border-radius:1.1rem;background:#f7faf9;padding:.75rem;box-shadow:0 22px 65px rgba(45,45,45,.08)}.window-top{height:2.25rem;display:flex;align-items:center;position:relative;padding:0 .45rem;font:600 .67rem var(--font-titulo);color:#707777}.window-dots{display:flex;gap:.3rem}.window-dots i{width:.43rem;height:.43rem;background:#c7ddda;border-radius:50%}.window-mark{margin-left:auto;color:#258d8d;font-weight:800}.window-page{background:white;border:1px solid #edf0ef;border-radius:.65rem;padding:1.2rem 1.3rem 1rem;overflow:hidden}.page-nav{height:2rem;border-bottom:1px solid #edf0ef;display:flex;align-items:center;gap:.8rem;font:600 .56rem var(--font-titulo);color:#4a4a4a}.page-nav>b{font-size:.75rem;color:#258d8d;margin-right:auto}.page-nav div{display:flex;gap:.35rem}.page-nav i{width:1.5rem;height:.18rem;border-radius:2rem;background:#e7efed}.page-nav>span{padding:.3rem .55rem;border:1px solid #dceae7;border-radius:2rem}.page-main{display:grid;grid-template-columns:1fr .85fr;gap:.7rem;align-items:center;min-height:225px;padding:.9rem 0}.page-copy{position:relative;z-index:1}.page-copy small{font:700 .51rem var(--font-titulo);letter-spacing:.12em;color:#258d8d}.page-copy strong{display:block;margin:.55rem 0;font:800 clamp(1.45rem,3.6vw,2.5rem)/1.04 var(--font-titulo);letter-spacing:-.04em;color:var(--color-carbon)}.page-copy em{font-style:normal;color:#258d8d}.page-copy p{max-width:17rem;font-size:.67rem;line-height:1.55;color:#596361}.page-cta{display:inline-flex;gap:.5rem;align-items:center;margin-top:.8rem;background:#176f6f;color:#fff;padding:.48rem .7rem;border-radius:2rem;font:600 .58rem var(--font-titulo)}.page-visual{height:170px;position:relative;overflow:hidden;border-radius:.55rem;background:#eaf5f2}.visual-sun{position:absolute;top:18%;right:17%;width:34%;aspect-ratio:1;border-radius:50%;background:#c6e8dd}.visual-building{position:absolute;bottom:18%;left:20%;width:58%;height:45%;background:#a9d8cb;border-radius:.3rem .3rem 0 0;display:flex;justify-content:space-evenly;align-items:center;padding:.5rem}.visual-building i{width:17%;height:55%;background:#f8fcfa;border-radius:.12rem}.visual-ground{position:absolute;bottom:12%;left:8%;width:84%;height:6%;background:#8dc3b5;border-radius:50%}.page-bottom{display:flex;gap:.4rem}.page-bottom span{height:.22rem;border-radius:2rem;background:#e6efed}.page-bottom span:first-child{width:24%}.page-bottom span:nth-child(2){width:14%}.page-bottom span:nth-child(3){width:19%}.window-caption{display:flex;justify-content:center;gap:.5rem;padding:.65rem .2rem .1rem;font:600 .65rem var(--font-titulo);color:#65716e}
@media(min-width:900px){.hero-grid{grid-template-columns:1fr 1fr;gap:4rem}.studio-window{justify-self:end}.page-main{min-height:260px}.page-visual{height:195px}}
@media(max-width:380px){.window-page{padding:.8rem}.page-main{grid-template-columns:1fr .7fr;min-height:190px}.page-visual{height:145px}.page-nav{font-size:.5rem}.page-nav i{width:1rem}}
@media(prefers-reduced-motion:reduce){.hero *{scroll-behavior:auto}.availability-dot::after{animation:none}}
</style>
