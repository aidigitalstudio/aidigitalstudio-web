---
// src/components/PorQueAI.astro

const razones = [
  {
    icono: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    titulo: 'Una presencia que genera confianza',
    descripcion: 'Una página clara y profesional ayuda a que tus clientes entiendan qué haces y encuentren cómo contactarte.',
  },
  {
    icono: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 18h6M9 5h6"/></svg>`,
    titulo: 'Claro desde el celular',
    descripcion: 'La página se adapta a pantallas pequeñas y organiza la información para que se pueda consultar sin esfuerzo.',
  },
  {
    icono: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`,
    titulo: 'Trato directo, sin intermediarios',
    descripcion: 'Conversas conmigo desde el inicio y sabes quién está trabajando en tu proyecto.',
  },
  {
    icono: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.4 8.4 0 01-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.4 8.4 0 013.8-.9h.5a8.5 8.5 0 018 8v.5z"/></svg>`,
    titulo: 'Más fácil hacer una consulta',
    descripcion: 'Tu página puede llevar a las personas directo a WhatsApp para preguntar por tus servicios.',
  },
  {
    icono: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/><path d="M9 12l2 2 4-4"/></svg>`,
    titulo: 'Alcance claro, sin cobros ocultos',
    descripcion: 'Acordamos qué incluye el trabajo y el costo antes de comenzar; no hay mensualidades ocultas.',
  },
];
---

<section
  id="por-que-ai"
  class="section bg-blanco"
  aria-labelledby="porquea-heading"
>
  <div class="container">
    <header style="margin-bottom: 3.5rem; text-align: center;">
      <span
        class="font-titulo text-turquesa"
        style="
          font-size: 0.75rem;
          font-weight: 700;
          letter-spacing: 0.15em;
          text-transform: uppercase;
          margin-bottom: 0.75rem;
          display: block;
          opacity: 1;
        "
      >
        Lo que gana tu negocio
      </span>
      <h2
        id="porquea-heading"
        class="font-titulo text-carbon reveal delay-100"
        style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; margin-bottom: 1.25rem;"
      >
        Presencia digital con acompañamiento cercano
      </h2>
      <p
        class="font-texto text-carbon-suave reveal delay-200"
        style="font-size: 1.0625rem; opacity: 0.9; max-width: 560px; margin-inline: auto; line-height: 1.7;"
      >
        Claridad para tus clientes y un proceso sencillo para ti.
      </p>
    </header>

    <div
      style="display: grid; grid-template-columns: 1fr; gap: 1.75rem;"
      class="razones-grid"
    >
      {razones.map((r, i) => (
        <article
          class={`reveal delay-${(i + 1) * 100}`}
          style="
            background-color: #fff;
            border: 1px solid var(--color-gris-borde);
            border-radius: 1rem;
            padding: 2rem;
            box-shadow: 0 8px 28px rgba(43,191,191,0.08);
          "
          aria-label={r.titulo}
        >
          <div
            style="
              width: 56px; height: 56px;
              background-color: rgba(43,191,191,0.12);
              border-radius: 0.75rem;
              display: flex; align-items: center; justify-content: center;
              margin-bottom: 1.25rem;
              color: var(--color-turquesa-oscuro);
            "
            set:html={r.icono}
          />

          <h3
            class="font-titulo text-carbon"
            style="font-size: 1.125rem; font-weight: 700; margin-bottom: 0.75rem;"
          >
            {r.titulo}
          </h3>

          <p
            class="font-texto text-carbon-suave"
            style="font-size: 0.9375rem; line-height: 1.7;"
          >
            {r.descripcion}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @media (min-width: 640px) {
    .razones-grid {
            grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (min-width: 900px) {
    .razones-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>

