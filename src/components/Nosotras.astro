---
// src/components/Nosotras.astro
---

<section
  id="nosotras"
  class="section bg-gris-claro"
  aria-labelledby="nosotras-heading"
>
  <div class="container">
    <!-- Encabezado -->
    <header style="margin-bottom: 3.5rem;">
      <span class="section-label reveal">El equipo</span>
      <h2
        id="nosotras-heading"
        class="section-title reveal delay-100"
      >
        Dos almas, una visión
      </h2>
      <p class="section-subtitle reveal delay-200">
        Somos Ámbar e Itzel, dos creadoras que combinamos estrategia, diseño
        y tecnología para darle voz digital a quienes lo merecen.
      </p>
    </header>

    <!-- Tarjetas de las fundadoras -->
    <div
      style="display: grid; grid-template-columns: 1fr; gap: 2rem;"
      class="founders-grid"
    >
      <!-- Ámbar -->
      <article class="card reveal delay-100" aria-label="Ámbar, cofundadora">
        <div
          style="
            width: 100%;
            aspect-ratio: 4/3;
            background: linear-gradient(135deg, var(--color-turquesa) 0%, var(--color-turquesa-oscuro) 100%);
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
          "
        >
          <!-- FOTO ÁMBAR: reemplazar esta etiqueta con <img> real -->
          <span
            class="font-titulo text-blanco"
            style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; opacity: 0.9;"
            aria-label="Espacio reservado para foto de Ámbar"
          >
            [FOTO ÁMBAR]
          </span>
        </div>

        <h3
          class="font-titulo text-carbon"
          style="font-size: 1.375rem; font-weight: 700; margin-bottom: 0.5rem;"
        >
          Ámbar
        </h3>
        <p
          class="text-turquesa font-titulo"
          style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;"
        >
          Cofundadora
        </p>
        <p class="font-texto text-carbon-suave" style="line-height: 1.7; font-size: 0.9375rem;">
          [DESCRIPCIÓN ÁMBAR — su rol, especialidad o lo que la hace única dentro del estudio.]
        </p>
      </article>

      <!-- Itzel -->
      <article class="card reveal delay-200" aria-label="Itzel, cofundadora">
        <div
          style="
            width: 100%;
            aspect-ratio: 4/3;
            background: linear-gradient(135deg, var(--color-naranja) 0%, var(--color-naranja-oscuro) 100%);
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
          "
        >
          <!-- FOTO ITZEL: reemplazar esta etiqueta con <img> real -->
          <span
            class="font-titulo text-blanco"
            style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; opacity: 0.9;"
            aria-label="Espacio reservado para foto de Itzel"
          >
            [FOTO ITZEL]
          </span>
        </div>

        <h3
          class="font-titulo text-carbon"
          style="font-size: 1.375rem; font-weight: 700; margin-bottom: 0.5rem;"
        >
          Itzel
        </h3>
        <p
          class="text-naranja font-titulo"
          style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;"
        >
          Cofundadora
        </p>
        <p class="font-texto text-carbon-suave" style="line-height: 1.7; font-size: 0.9375rem;">
          [DESCRIPCIÓN ITZEL — su rol, especialidad o lo que la hace única dentro del estudio.]
        </p>
      </article>
    </div>

    <!-- Frase de marca -->
    <blockquote
      class="reveal"
      style="
        margin: 3.5rem auto 0;
        max-width: 680px;
        text-align: center;
        padding: 2rem;
        border-left: none;
        border-top: 2px solid var(--color-turquesa);
        border-bottom: 2px solid var(--color-turquesa);
      "
    >
      <p
        class="font-titulo text-carbon"
        style="font-size: clamp(1.125rem, 3vw, 1.5rem); font-weight: 700; line-height: 1.4; font-style: italic;"
      >
        "Una visión, dos almas. Diseños con propósito."
      </p>
    </blockquote>
  </div>
</section>

<style>
  @media (min-width: 640px) {
    .founders-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>

