---
// src/components/Servicios.astro

const servicios = [
  {
    icono: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    titulo: 'Desarrollo web',
    descripcion: 'Tu página, lista para trabajar. Rápida, segura, fácil de usar y que se ve perfecta en cualquier celular o computadora.',
  },
  {
    icono: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
    titulo: 'Presencia digital',
    descripcion: 'Que te encuentren. Configuramos tu perfil de Google, redes sociales y todo lo necesario para que tu negocio aparezca donde tus clientes buscan.',
  },
  {
    icono: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
    titulo: 'Diseño estratégico',
    descripcion: 'No solo que se vea bien, sino que convierta. Diseñamos con intención: cada color, texto e imagen lleva al visitante a contactarte.',
  },
];
---

<section
  id="servicios"
  class="section bg-blanco"
  aria-labelledby="servicios-heading"
>
  <div class="container">
    <header style="margin-bottom: 3.5rem;">
      <span class="section-label reveal">¿Qué hacemos?</span>
      <h2
        id="servicios-heading"
        class="section-title reveal delay-100"
      >
        Servicios diseñados para crecer
      </h2>
      <p class="section-subtitle reveal delay-200">
        Todo lo que tu negocio necesita para tener una presencia digital sólida,
        en un solo lugar y con personas que realmente te escuchan.
      </p>
    </header>

    <div
      style="display: grid; grid-template-columns: 1fr; gap: 1.75rem;"
      class="servicios-grid"
    >
      {servicios.map((s, i) => (
        <article
          class={`card reveal delay-${(i + 1) * 100}`}
          aria-label={`Servicio: ${s.titulo}`}
        >
          <!-- Ícono -->
          <div
            style="
              width: 60px; height: 60px;
              background-color: rgba(43,191,191,0.1);
              border-radius: 0.75rem;
              display: flex; align-items: center; justify-content: center;
              margin-bottom: 1.25rem;
              color: var(--color-turquesa);
            "
            set:html={s.icono}
          />

          <h3
            class="font-titulo text-carbon"
            style="font-size: 1.1875rem; font-weight: 700; margin-bottom: 0.75rem;"
          >
            {s.titulo}
          </h3>

          <p
            class="font-texto text-carbon-suave"
            style="font-size: 0.9375rem; line-height: 1.7;"
          >
            {s.descripcion}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @media (min-width: 640px) {
    .servicios-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (min-width: 900px) {
    .servicios-grid {
      grid-template-columns: 1fr 1fr 1fr !important;
    }
  }
</style>

