<style>
.wa-btn{position:fixed;right:1.25rem;bottom:max(1.25rem,env(safe-area-inset-bottom));z-index:40;width:3.25rem;height:3.25rem;border-radius:50%;background:var(--color-naranja);color:white;display:flex;align-items:center;justify-content:center;gap:.45rem;box-shadow:0 5px 18px rgba(45,45,45,.2);transition:transform .2s ease,box-shadow .2s ease}.wa-btn:hover,.wa-btn:focus-visible{transform:translateY(-2px);box-shadow:0 8px 22px rgba(45,45,45,.24)}.wa-label{position:absolute;right:calc(100% + .55rem);white-space:nowrap;padding:.4rem .65rem;border:1px solid #e5e5e5;border-radius:2rem;background:#fff;color:#2d2d2d;font:600 .7rem var(--font-titulo);box-shadow:0 3px 12px rgba(45,45,45,.08)}@media(max-width:640px){.wa-btn{display:none}}@media(prefers-reduced-motion:reduce){.wa-btn{transition:none}}
