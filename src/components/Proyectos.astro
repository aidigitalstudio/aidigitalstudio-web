---
import { site } from '../data/site';
---
<section id="proyectos" class="section bg-blanco" aria-labelledby="proyectos-heading">
 <div class="container">
  <header class="projects-heading"><div><span class="section-label reveal">Proyectos</span><h2 id="proyectos-heading" class="section-title reveal delay-100">Trabajo con intención y contexto.</h2></div><p class="section-subtitle reveal delay-200">Cada propuesta parte de una necesidad concreta y se organiza para que navegar y contactar sea sencillo.</p></header>
  <div class="projects-grid">
   {site.proyectos.map((p,i)=><article class={`project-card reveal delay-${(i+1)*100}`}>
    <div class={`project-window ${p.tipo}`} aria-hidden="true">
     <div class="project-browser"><span class="browser-dots"><i></i><i></i><i></i></span><span class="browser-title">{p.nombre}</span><span class="browser-menu">•••</span></div>
     {p.tipo==='veterinaria' ? <div class="project-site vet-site"><div class="site-nav"><b>{p.nombre}</b><span>Servicios　 Equipo　 Contacto</span></div><div class="site-hero"><div><small>CUIDADO VETERINARIO</small><strong>Salud y cariño<br/>para tu mascota.</strong><span class="site-action">Conoce los servicios　 →</span></div><div class="vet-illustration"><div class="vet-cross">+</div><div class="vet-paw">✦</div></div></div><div class="site-strip"><span>Atención médica</span><span>Perfil de mascotas</span><span>Agenda de citas</span></div></div> : <div class="project-site tour-site"><div class="site-nav"><b>{p.nombre}</b><span>Destinos　 Experiencias　 Contacto</span></div><div class="tour-visual"><div class="tour-copy"><small>DESCUBRE PANAMÁ</small><strong>Un destino nuevo<br/>te espera.</strong><span class="site-action">Explorar destinos　 →</span></div><div class="coast"><i></i><i></i><i></i><b></b></div></div><div class="site-strip"><span>Destinos</span><span>Experiencias</span><span>Consultas y reservas</span></div></div>}
    </div>
    <div class="project-content"><div class="project-top"><h3 class="font-titulo text-carbon">{p.nombre}</h3><span class="badge">{p.estado}</span></div><div class="project-details"><div><span>Situación</span><p>{p.situacion}</p></div><div><span>Solución</span><p>{p.solucion}</p></div></div><a class="btn btn-outline" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`Ver proyecto ${p.nombre} en una nueva pestaña`}>Ver proyecto <span aria-hidden="true">↗</span></a></div>
   </article>)}
  </div>
 </div>
</section>
<style>
.projects-heading{display:grid;grid-template-columns:1fr;gap:1rem;margin-bottom:2.5rem}.projects-heading .section-title{max-width:15ch}.projects-heading .section-subtitle{align-self:end;margin-bottom:1.4rem}.projects-grid{display:grid;grid-template-columns:1fr;gap:1.5rem}.project-card{overflow:hidden;border:1px solid #e5e5e5;border-radius:1rem;background:#fff;box-shadow:0 12px 35px rgba(45,45,45,.045);transition:transform .25s ease,box-shadow .25s ease}.project-card:hover{transform:translateY(-3px);box-shadow:0 18px 44px rgba(45,45,45,.09)}.project-window{padding:1rem;background:#f4f8f7;border-bottom:1px solid #e5e5e5}.project-browser{height:2rem;border:1px solid #e5e5e5;border-bottom:0;border-radius:.6rem .6rem 0 0;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 .7rem}.browser-dots{display:flex;gap:.28rem}.browser-dots i{width:.4rem;height:.4rem;border-radius:50%;background:#c1dbd5}.browser-title{font:600 .6rem var(--font-titulo);color:#596361}.browser-menu{color:#84918e;font-size:.6rem}.project-site{background:#fff;border:1px solid #e9efed;border-radius:0 0 .6rem .6rem;padding:.75rem;min-height:220px;display:flex;flex-direction:column}.site-nav{height:1.5rem;display:flex;align-items:center;justify-content:space-between;font:600 .48rem var(--font-titulo);color:#596361;border-bottom:1px solid #edf1f0}.site-nav b{font-size:.62rem;color:#258d8d}.site-hero{flex:1;display:flex;align-items:center;justify-content:space-between;padding:.9rem .3rem;gap:.5rem}.site-hero small,.tour-copy small{font:700 .46rem var(--font-titulo);letter-spacing:.1em;color:#258d8d}.site-hero strong,.tour-copy strong{display:block;margin:.4rem 0 .55rem;font:750 clamp(1.1rem,2.5vw,1.55rem)/1.08 var(--font-titulo);letter-spacing:-.035em;color:#2d2d2d}.site-action{display:inline-flex;border-radius:2rem;padding:.38rem .55rem;background:#e5f3f0;color:#237b70;font:700 .47rem var(--font-titulo)}.vet-illustration{width:31%;height:105px;position:relative;display:grid;place-items:center;background:#eaf5f2;border-radius:48% 48% .5rem .5rem}.vet-cross{font:bold 3.8rem var(--font-texto);color:#8cc8b9}.vet-paw{position:absolute;right:5%;top:8%;width:1.5rem;height:1.5rem;border-radius:50%;display:grid;place-items:center;background:#fff;color:#258d8d;box-shadow:0 4px 12px #2d2d2d12}.site-strip{border-top:1px solid #edf1f0;padding-top:.5rem;display:flex;justify-content:space-between;gap:.25rem;font:600 .45rem var(--font-titulo);color:#596361}.tour-visual{position:relative;isolation:isolate;flex:1;min-height:155px;display:flex;align-items:center;padding:.7rem;overflow:hidden;background:linear-gradient(120deg,#fff 45%,#eff7f3 45%)}.tour-copy{position:relative;z-index:1}.coast{position:absolute;z-index:-1;right:0;bottom:0;width:49%;height:92%;overflow:hidden;background:#d6ebe2;border-radius:55% 0 0 0}.coast i{position:absolute;bottom:-35%;left:15%;width:100%;height:85%;border-radius:50%;background:#8bbfa9;transform:rotate(-14deg)}.coast i:nth-child(2){left:46%;bottom:-28%;background:#b5d9c4}.coast i:nth-child(3){left:65%;bottom:-48%;background:#6eac92}.coast b{position:absolute;right:12%;top:24%;width:1.15rem;height:1.15rem;border-radius:50%;background:#f1d48f}.project-content{padding:1.3rem}.project-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:1.1rem}.project-top h3{font-size:1.15rem;font-weight:750}.badge{flex:none;padding:.32rem .62rem;border-radius:2rem;background:#e5f3f0;color:#176f6f;font:700 .66rem var(--font-titulo)}.project-details{display:grid;grid-template-columns:1fr;gap:.85rem;margin-bottom:1.2rem}.project-details>div{display:grid;grid-template-columns:5.5rem 1fr;gap:.4rem;align-items:start}.project-details span{font:700 .64rem var(--font-titulo);letter-spacing:.04em;color:#218c8c;text-transform:uppercase}.project-details p{font-size:.82rem;line-height:1.55;color:#4a4a4a}.project-content .btn{font-size:.82rem;padding:.58rem .95rem}
@media(min-width:760px){.projects-heading{grid-template-columns:1.1fr .9fr;gap:3rem;align-items:end;margin-bottom:3rem}.projects-grid{grid-template-columns:1fr 1fr;gap:1.35rem}.project-window{padding:1.15rem}.project-site{min-height:240px;padding:.9rem}.site-hero{padding:1rem .5rem}.project-content{padding:1.5rem}.project-details{min-height:6.2rem}}
@media(max-width:380px){.project-details>div{grid-template-columns:4.5rem 1fr}.project-window{padding:.65rem}.project-content{padding:1rem}}
</style>
