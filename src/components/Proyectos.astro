---
import { site } from '../data/site';
---
<section id="proyectos" class="section bg-blanco" aria-labelledby="proyectos-heading">
  <div class="container">
    <header style="margin-bottom:3rem">
      <span class="section-label reveal">Proyectos</span>
      <h2 id="proyectos-heading" class="section-title reveal delay-100">Ideas que ya están tomando forma</h2>
      <p class="section-subtitle reveal delay-200">Una muestra de páginas y experiencias digitales en las que hemos trabajado.</p>
    </header>
    <div class="projects">
      {site.proyectos.map((p, i) => <article class={`card project reveal delay-${(i + 1) * 100}`}>
        <div class="screen" aria-hidden="true">
          <div class="browser"><i></i><i></i><i></i><span>{p.nombre}</span></div>
          {p.tipo === 'veterinaria' ? <div class="preview vet"><small>CUIDADO PARA QUIENES MÁS QUIERES</small><b>Su bienestar,<br/>siempre cerca.</b><div class="preview-pill">Agenda tu cita <span>→</span></div><div class="pet-shape">♡</div></div> : <div class="preview tour"><small>DESCUBRE PANAMÁ</small><b>Tu próxima<br/>aventura empieza aquí.</b><div class="preview-pill">Explorar destinos <span>→</span></div><div class="sun"></div></div>}
        </div>
        <div class="project-copy">
          <span class={`badge ${p.estado === 'Demostrativo' ? 'demo' : ''}`}>{p.estado}</span>
          <h3 class="font-titulo text-carbon">{p.nombre}</h3>
          <p class="font-texto text-carbon-suave">{p.descripcion}</p>
          <a class="btn btn-outline" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`Ver proyecto ${p.nombre} en una nueva pestaña`}>Ver proyecto <span aria-hidden="true">↗</span></a>
        </div>
      </article>)}
    </div>
  </div>
</section>
<style>
 .projects{display:grid;grid-template-columns:1fr;gap:1.5rem}.project{padding:0;overflow:hidden}.screen{padding:1rem;background:#f2fbfa;border-bottom:1px solid #e5e5e5}.browser{height:2rem;border:1px solid #e5e5e5;border-radius:.55rem .55rem 0 0;background:#fff;display:flex;align-items:center;gap:.3rem;padding:0 .65rem}.browser i{width:.42rem;height:.42rem;border-radius:50%;background:#b9dede}.browser span{font:600 .65rem var(--font-titulo);margin:auto;color:#4a4a4a}.preview{position:relative;isolation:isolate;overflow:hidden;min-height:205px;padding:1.4rem;background:#fff;border-radius:0 0 .55rem .55rem;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:.55rem}.preview small{font:700 .55rem var(--font-titulo);letter-spacing:.1em;color:#258d8d}.preview b{font:700 clamp(1.2rem,3vw,1.8rem)/1.1 var(--font-titulo);color:#2d2d2d}.preview-pill{z-index:1;margin-top:.3rem;padding:.45rem .7rem;border-radius:2rem;background:#2bbfbf;color:white;font:600 .65rem var(--font-titulo)}.preview-pill span{margin-left:.5rem}.pet-shape{position:absolute;z-index:-1;right:1.2rem;bottom:-1.4rem;width:8rem;height:8rem;border-radius:48% 48% 40% 40%;background:#d8f2ed;color:#fff;font-size:5rem;display:grid;place-items:center}.tour{background:linear-gradient(125deg,#fff 50%,#e3f5f1 50%)}.sun{position:absolute;z-index:-1;right:2rem;bottom:1rem;width:6rem;height:6rem;border-radius:50%;background:#b9e7df}.project-copy{padding:1.5rem}.badge{display:inline-block;background:#e2f6f3;color:#176f6f;padding:.3rem .65rem;border-radius:2rem;font:700 .7rem var(--font-titulo);margin-bottom:.9rem}.badge.demo{background:#edf5f4}.project h3{font-size:1.25rem;font-weight:700;margin-bottom:.5rem}.project p{font-size:.92rem;line-height:1.65;margin-bottom:1.2rem}.project .btn{font-size:.85rem;padding:.6rem 1rem}
 @media(min-width:700px){.projects{grid-template-columns:1fr 1fr}.screen{padding:1.2rem}.preview{min-height:230px}}
</style>
