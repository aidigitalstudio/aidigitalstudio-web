---
import { site } from '../data/site';
---
<section id="proyectos" class="section bg-blanco" aria-labelledby="proyectos-heading">
 <div class="container">
  <header class="projects-heading"><div><span class="section-label reveal">Proyectos</span><h2 id="proyectos-heading" class="section-title reveal delay-100">Trabajo con intención y contexto.</h2></div><p class="section-subtitle reveal delay-200">Cada propuesta parte de una necesidad concreta y se organiza para que navegar y contactar sea sencillo.</p></header>
  <div class="projects-grid">
   {site.proyectos.map((p,i)=><article class={`project-card reveal delay-${(i+1)*100}`}>
    <figure class="project-shot">
     <div class="project-browser"><span class="browser-dots"><i></i><i></i><i></i></span><span class="browser-title">{p.nombre}</span><span class="browser-menu">•••</span></div>
     <img src={p.imagen} alt={`Captura de pantalla del sitio web ${p.nombre}`} width="800" height="500" loading="lazy" decoding="async" class="project-screenshot" />
    </figure>
    <div class="project-content"><div class="project-top"><h3 class="font-titulo text-carbon">{p.nombre}</h3><span class="badge">{p.estado}</span></div><div class="project-details"><div><span>Situación</span><p>{p.situacion}</p></div><div><span>Solución</span><p>{p.solucion}</p></div><div><span>Resultado</span><p>{p.resultado}</p></div></div><a class="btn btn-outline" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`Ver proyecto ${p.nombre} en una nueva pestaña`}>Ver proyecto <span aria-hidden="true">↗</span></a></div>
   </article>)}
  </div>
 </div>
</section>
<style>
.projects-heading{display:grid;grid-template-columns:1fr;gap:1rem;margin-bottom:2.5rem}.projects-heading .section-title{max-width:15ch}.projects-heading .section-subtitle{align-self:end;margin-bottom:1.4rem}.projects-grid{display:grid;grid-template-columns:1fr;gap:1.5rem}.project-card{overflow:hidden;border:1px solid #e5e5e5;border-radius:1rem;background:#fff;box-shadow:0 12px 35px rgba(45,45,45,.045);transition:transform .25s ease,box-shadow .25s ease}.project-card:hover{transform:translateY(-3px);box-shadow:0 18px 44px rgba(45,45,45,.09)}.project-shot{margin:0;border-bottom:1px solid #e5e5e5;background:#f4f8f7;overflow:hidden}.project-browser{height:2rem;border:1px solid #e5e5e5;border-bottom:0;border-radius:.6rem .6rem 0 0;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 .7rem}.browser-dots{display:flex;gap:.28rem}.browser-dots i{width:.4rem;height:.4rem;border-radius:50%;background:#c1dbd5}.browser-title{font:600 .6rem var(--font-titulo);color:#596361}.browser-menu{color:#84918e;font-size:.6rem}.project-screenshot{width:100%;height:240px;object-fit:cover;object-position:top;display:block}.project-content{padding:1.3rem}.project-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:1.1rem}.project-top h3{font-size:1.15rem;font-weight:750}.badge{flex:none;padding:.32rem .62rem;border-radius:2rem;background:#e5f3f0;color:#176f6f;font:700 .66rem var(--font-titulo)}.project-details{display:grid;grid-template-columns:1fr;gap:.85rem;margin-bottom:1.2rem}.project-details>div{display:grid;grid-template-columns:5.5rem 1fr;gap:.4rem;align-items:start}.project-details span{font:700 .64rem var(--font-titulo);letter-spacing:.04em;color:#218c8c;text-transform:uppercase}.project-details p{font-size:.82rem;line-height:1.55;color:#4a4a4a}.project-content .btn{font-size:.82rem;padding:.58rem .95rem}
@media(min-width:760px){.projects-heading{grid-template-columns:1.1fr .9fr;gap:3rem;align-items:end;margin-bottom:3rem}.projects-grid{grid-template-columns:1fr 1fr;gap:1.35rem}.project-shot{background:#f4f8f7}.project-screenshot{height:260px}.project-content{padding:1.5rem}.project-details{min-height:6.2rem}}
@media(max-width:380px){.project-details>div{grid-template-columns:4.5rem 1fr}.project-shot{padding:0}.project-content{padding:1rem}}
</style>
