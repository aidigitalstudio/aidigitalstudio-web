---
// src/components/Header.astro
import { whatsappUrl, nombre } from '../data/site';

const nav = [
  { href: '#nosotras',  label: 'Nosotras' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso',   label: 'Proceso' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto',  label: 'Contacto' },
];
---

<header
  class="bg-blanco sticky top-0 z-50 border-b border-gris-borde"
  style="backdrop-filter: blur(8px); background-color: rgba(255,255,255,0.95);"
>
  <div class="container" style="padding-inline: 1.25rem; margin-inline: auto; max-width: 1100px;">
    <nav
      class="flex items-center justify-between"
      style="padding-block: 1rem;"
      aria-label="Navegación principal"
    >
      <!-- Logo / nombre -->
      <a
        href="/"
        class="font-titulo text-carbon"
        style="font-weight: 800; font-size: 1.1rem; letter-spacing: -0.01em; text-decoration: none;"
        aria-label={`${nombre} — ir al inicio`}
      >
        <span style="color: var(--color-turquesa);">A&amp;I</span>
        <span style="margin-left: 0.3em;">Digital Studio</span>
      </a>

      <!-- Menú escritorio -->
      <ul
        class="hidden md:flex items-center gap-6 font-texto"
        style="list-style: none; margin: 0; padding: 0; font-size: 0.9375rem;"
        role="list"
      >
        {nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="text-carbon-suave"
              style="text-decoration: none; transition: color 0.2s ease; font-weight: 500;"
              onmouseover="this.style.color='var(--color-turquesa)'"
              onmouseout="this.style.color=''"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA + hamburguesa -->
      <div class="flex items-center gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-naranja hidden sm:inline-flex"
          style="padding: 0.6rem 1.25rem; font-size: 0.875rem;"
          aria-label="Cotizar proyecto por WhatsApp"
        >
          Cotizar
        </a>

        <!-- Botón hamburguesa (mobile) -->
        <button
          id="menu-toggle"
          class="md:hidden text-carbon"
          style="background: none; border: none; cursor: pointer; padding: 0.5rem;"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6"  x2="21" y2="6"  />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Menú mobile desplegable -->
    <div
      id="mobile-menu"
      class="md:hidden bg-blanco border-t border-gris-borde"
      style="display: none; padding-block: 1rem;"
      aria-hidden="true"
    >
      <ul style="list-style: none; margin: 0; padding: 0;" role="list">
        {nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="text-carbon font-texto"
              style="display: block; padding: 0.75rem 0; font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--color-gris-borde);"
            >
              {label}
            </a>
          </li>
        ))}
        <li style="margin-top: 1rem;">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-naranja"
            style="width: 100%; justify-content: center;"
          >
            Cotizar por WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.style.display === 'block';
    if (menu) menu.style.display = isOpen ? 'none' : 'block';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (menu) menu.setAttribute('aria-hidden', String(isOpen));
  });

  // Cierra menú al hacer clic en enlace interno
  menu?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => {
      if (menu) menu.style.display = 'none';
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
    });
  });
</script>

