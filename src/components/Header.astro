---
// src/components/Header.astro
import { whatsappUrl, nombre } from '../data/site';

const nav = [
  { href: '#nosotras',   label: 'El estudio' },
  { href: '#servicios',  label: 'Servicios' },
  { href: '#proceso',    label: 'Proceso' },
  { href: '#proyectos',  label: 'Proyectos' },
  { href: '#por-que-ai', label: '¿Por qué A&I?' },
  { href: '#preguntas',  label: 'Preguntas frecuentes' },
  { href: '#contacto',   label: 'Contacto' },
];
---

<header
  class="bg-blanco sticky top-0 z-50"
  style="
    border-bottom: 1px solid var(--color-gris-borde);
    backdrop-filter: blur(10px);
    background-color: rgba(255,255,255,0.96);
  "
>
  <div
    class="container"
    style="padding-inline: 1.25rem; margin-inline: auto; max-width: 1100px;"
  >
    <nav
      style="
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1rem;
      "
      aria-label="Navegación principal"
    >
      <!-- ── Logo ─────────────────────────────────────────────────────── -->
      <a
        href="/"
        class="font-titulo text-carbon"
        style="font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; text-decoration: none; display: flex; align-items: center; gap: 0.1em;"
        aria-label={`${nombre} — ir al inicio`}
      >
        <span style="color: #176f6f;">A&amp;I</span>
        <span style="margin-left: 0.3em; color: var(--color-carbon);">Digital Studio</span>
      </a>

      <!-- ── Menú escritorio ───────────────────────────────────────────── -->
      <ul
        class="desktop-nav"
        style="list-style: none; margin: 0; padding: 0; font-size: 0.9375rem;"
        role="list"
      >
        {nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="font-texto text-carbon-suave"
              style="text-decoration: none; transition: color 0.2s ease; font-weight: 500;"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- ── CTA + hamburguesa ─────────────────────────────────────────── -->
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-naranja cta-desktop"
          style="padding: 0.6rem 1.25rem; font-size: 1rem; font-weight: 700;"
          aria-label="Cotizar proyecto por WhatsApp"
        >
          Cotizar
        </a>

        <button
          id="menu-toggle"
          class="hamburger"
          style="background: none; border: none; cursor: pointer; padding: 0.5rem; color: var(--color-carbon);"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6"  x2="21" y2="6"  />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- ── Menú mobile ───────────────────────────────────────────────── -->
    <div
      id="mobile-menu"
      hidden
      style="padding-bottom: 1.25rem; border-top: 1px solid var(--color-gris-borde);"
      aria-hidden="true"
    >
      <ul style="list-style: none; margin: 0; padding: 0;" role="list">
        {nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="font-texto text-carbon"
              style="display: block; padding: 0.75rem 0; font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--color-gris-borde);"
            >
              {label}
            </a>
          </li>
        ))}
        <li style="margin-top: 1rem;">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-naranja"
            style="width: 100%; justify-content: center;"
            aria-label="Cotizar proyecto por WhatsApp"
          >
            Cotizar por WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  /* Escritorio: lista horizontal con gaps */
  .desktop-nav {
    display: none;
    gap: 2rem;
  }
  .cta-desktop  { display: none; }
  .hamburger    { display: flex; }
  .desktop-nav a:hover,
  .desktop-nav a:focus-visible { color: var(--color-turquesa-oscuro); }

  @media (min-width: 768px) {
    .desktop-nav  { display: flex; }
    .cta-desktop  { display: inline-flex; }
    .hamburger    { display: none; }
    #mobile-menu  { display: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');

  const closeMobileMenu = () => {
    if (menu) menu.hidden = true;
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu ? !menu.hidden : false;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.setAttribute('aria-hidden', String(isOpen));
  });

  menu?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) closeMobileMenu();
  });
</script>
