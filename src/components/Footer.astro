---
// src/components/Footer.astro
import { nombre, lema, correo, instagram, instagramUrl, whatsappUrl, whatsappNumero } from '../data/site';

const navLinks = [
  { href: '#nosotras',  label: 'El estudio' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso',   label: 'Proceso' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto',  label: 'Contacto' },
];
---

<footer
  class="bg-carbon"
  style="padding-inline: 1.25rem;"
  aria-label="Pie de página"
>
  <!-- ── Cuerpo del footer ──────────────────────────────────────────────── -->
  <div
    class="container footer-grid"
    style="padding-top: 3.5rem; padding-bottom: 2.5rem;"
  >

    <!-- Columna 1: Marca -->
    <div>
      <p
        class="font-titulo text-blanco"
        style="font-size: 1.0625rem; font-weight: 800; margin-bottom: 0.5rem;"
      >
        <span style="color: var(--color-turquesa);">A&amp;I</span> Digital Studio
      </p>
      <p
        class="font-texto text-blanco"
        style="font-size: 0.875rem; opacity: 0.6; line-height: 1.65; max-width: 240px;"
      >
        {lema}
      </p>
    </div>

    <!-- Columna 2: Navegación -->
    <nav aria-label="Navegación de pie de página">
      <p class="footer-col-label">Ir a</p>
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.625rem;" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="footer-link font-texto text-blanco"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Columna 3: Contacto -->
    <div>
      <p class="footer-col-label">Contacto</p>
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem;" role="list">
        <li>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link font-texto text-blanco"
            aria-label={`Escríbenos por WhatsApp al ${whatsappNumero}`}
          >
            WhatsApp · {whatsappNumero}
          </a>
          <span
            class="font-titulo"
            style="display: block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-turquesa); opacity: 0.9; margin-top: 0.1rem;"
          >
            Solo WhatsApp
          </span>
        </li>
        <li>
          <a
            href={`mailto:${correo}`}
            class="footer-link font-texto text-blanco"
            aria-label={`Enviar correo a ${correo}`}
          >
            {correo}
          </a>
        </li>
        <li>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link font-texto text-blanco footer-ig-link"
            aria-label={`Seguirnos en Instagram: ${instagram}`}
          >
            <svg
              width="15" height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              style="flex-shrink: 0;"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            {instagram}
          </a>
        </li>
      </ul>
    </div>

  </div>

  <!-- ── Banda inferior ─────────────────────────────────────────────────── -->
  <div
    class="container"
    style="
      padding-block: 1.25rem;
      border-top: 1px solid rgba(255,255,255,0.1);
      text-align: center;
    "
  >
    <p
      class="font-texto text-blanco"
      style="font-size: 0.8rem; opacity: 0.4;"
    >
      {nombre} · {lema}
    </p>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer-col-label {
    font-family: var(--font-titulo);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.4;
    margin: 0 0 0.875rem 0;
  }

  .footer-link {
    font-size: 0.9rem;
    opacity: 0.65;
    text-decoration: none;
    transition: opacity 0.2s ease, color 0.2s ease;
    display: inline-block;
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    opacity: 1;
    color: var(--color-turquesa);
  }

  /* Instagram: muestra ícono + texto en fila */
  .footer-ig-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
</style>
