---
import { nombre, lema, correo, instagram, instagramUrl, whatsappUrl, whatsappNumero, whatsappNota } from '../data/site';

const year = new Date().getFullYear();
const navLinks = [
  { href: '#nosotras',   label: 'El estudio' },
  { href: '#servicios',  label: 'Servicios' },
  { href: '#proceso',    label: 'Proceso' },
  { href: '#proyectos',  label: 'Proyectos' },
  { href: '#por-que-ai', label: '¿Por qué A&I?' },
  { href: '#preguntas',  label: 'Preguntas frecuentes' },
  { href: '#contacto',   label: 'Contacto' },
];
---
<footer id="site-footer" class="bg-blanco" aria-label="Pie de página">
 <div id="footer-grid">
  <section aria-label={nombre}>
   <a href="/" class="font-titulo text-carbon" aria-label={`${nombre}, ir al inicio`}>
    <span id="footer-brand-mark">A&amp;I</span> <span>Digital Studio</span>
   </a>
   <p id="footer-tagline" class="font-texto text-carbon">{lema}</p>
  </section>

  <nav aria-label="Navegación de pie de página">
   <h2 class="font-titulo text-carbon">Ir a</h2>
   <ul>
    {navLinks.map(({ href, label }) => <li><a class="font-texto text-carbon" href={href}>{label}</a></li>)}
   </ul>
  </nav>

  <section aria-labelledby="footer-contact-heading">
   <h2 id="footer-contact-heading" class="font-titulo text-carbon">Contacto</h2>
   <ul>
   <li id="footer-whatsapp">
     <a class="font-texto text-carbon" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={`Escribirnos por WhatsApp al ${whatsappNumero}`}>
      <span>{whatsappNumero}</span><span id="footer-whatsapp-note">{whatsappNota}</span>
     </a>
    </li>
    <li><a class="font-texto text-carbon" href={`mailto:${correo}`} aria-label={`Enviar correo a ${correo}`}>{correo}</a></li>
    <li><a class="font-texto text-carbon" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visitar Instagram ${instagram}`}>{instagram}</a></li>
   </ul>
  </section>
 </div>

 <div id="footer-bottom">
  <p class="font-texto text-carbon footer-credits">
    © {year} {nombre} &nbsp;·&nbsp;
    <a href="/politica-de-privacidad" class="font-texto text-carbon footer-legal-link">Política de privacidad</a>
  </p>
  <p class="font-texto text-carbon footer-made">Diseñado y desarrollado por A&amp;I Digital Studio en Panamá</p>
 </div>
</footer>
<style>
#site-footer{border-top:1px solid #dfe5e3;padding:2.2rem clamp(1rem,4vw,2rem) 0}#footer-grid{display:grid;grid-template-columns:1fr;gap:1.7rem;width:100%;max-width:1100px;margin-inline:auto;padding-bottom:1.6rem}#footer-grid section,#footer-grid nav{min-width:0}#footer-grid section>a:first-child{display:inline-flex;align-items:center;gap:.28rem;font-size:1rem;font-weight:700;letter-spacing:-.02em;text-decoration:none}#footer-brand-mark{color:#176f6f}#footer-tagline{max-width:260px;margin:.45rem 0 0;font-size:.88rem;line-height:1.55}#footer-grid h2{margin:0 0 .65rem;font-size:.72rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase}#footer-grid ul{display:flex;flex-direction:column;gap:.5rem;list-style:none;margin:0;padding:0}#footer-grid nav ul{gap:.5rem}#footer-grid li{min-width:0}#footer-grid li>a{display:inline-flex;align-items:baseline;gap:.45rem;min-height:1.6rem;font-size:.87rem;line-height:1.5;overflow-wrap:anywhere;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:.18em;transition:color .18s ease,text-decoration-color .18s ease}#footer-grid li>a:hover,#footer-grid li>a:focus-visible,#footer-grid section>a:first-child:hover{color:#176f6f;text-decoration-color:currentColor}#footer-whatsapp>a{flex-direction:column;align-items:flex-start;gap:.05rem}#footer-whatsapp-note{color:#176f6f;font-family:var(--font-titulo);font-size:.72rem;font-weight:700}#footer-bottom{width:100%;max-width:1100px;margin-inline:auto;border-top:1px solid #dfe5e3;padding:1rem 4.25rem 1rem 0;text-align:center}#footer-bottom p{margin:0;font-size:.78rem;line-height:1.55}.footer-credits{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.25rem}.footer-legal-link{text-decoration:underline;text-decoration-color:transparent;text-underline-offset:.18em;transition:color .18s ease,text-decoration-color .18s ease}.footer-legal-link:hover,.footer-legal-link:focus-visible{color:#176f6f;text-decoration-color:currentColor}.footer-made{margin-top:.35rem !important;font-size:.72rem;opacity:.7}
@media(min-width:760px){#site-footer{padding-top:2.5rem}#footer-grid{grid-template-columns:1.2fr .8fr 1.25fr;gap:2rem;padding-bottom:2rem}#footer-bottom p{font-size:.8rem}}
@media(min-width:1000px){#footer-grid{grid-template-columns:1.25fr .75fr 1.2fr;gap:3rem}}
@media(max-width:380px){#site-footer{padding-inline:1rem}#footer-grid{gap:1.35rem}#footer-grid li>a{font-size:.83rem}#footer-bottom{padding-right:0}}
</style>
