---
// src/components/Footer.astro
import { nombre, lema, correo, instagram, instagramUrl, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer
  class="bg-carbon"
  style="padding-block: 3rem; padding-inline: 1.25rem;"
  aria-label="Pie de página"
>
  <div
    class="container"
    style="display: grid; grid-template-columns: 1fr; gap: 2.5rem;"
  >
    <!-- Columna 1: Marca -->
    <div>
      <p
        class="font-titulo text-blanco"
        style="font-size: 1.1rem; font-weight: 800; margin-bottom: 0.5rem;"
      >
        <span style="color: var(--color-turquesa);">A&amp;I</span> Digital Studio
      </p>
      <p
        class="font-texto text-blanco"
        style="font-size: 0.875rem; opacity: 0.65; line-height: 1.6; max-width: 280px;"
      >
        {lema}
      </p>
    </div>

    <!-- Columna 2: Navegación rápida -->
    <nav aria-label="Navegación de pie de página">
      <p
        class="font-titulo text-blanco"
        style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem; opacity: 0.5;"
      >
        Ir a
      </p>
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.625rem;" role="list">
        {[
          { href: '#nosotras',  label: 'Nosotras' },
          { href: '#servicios', label: 'Servicios' },
          { href: '#proceso',   label: 'Proceso' },
          { href: '#proyectos', label: 'Proyectos' },
          { href: '#contacto',  label: 'Contacto' },
        ].map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="font-texto text-blanco"
              style="font-size: 0.9rem; opacity: 0.7; text-decoration: none; transition: opacity 0.2s ease;"
              onmouseover="this.style.opacity='1'; this.style.color='var(--color-turquesa)'"
              onmouseout="this.style.opacity='0.7'; this.style.color=''"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Columna 3: Contacto rápido -->
    <div>
      <p
        class="font-titulo text-blanco"
        style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem; opacity: 0.5;"
      >
        Contacto
      </p>
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem;" role="list">
        <li>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-texto text-blanco"
            style="font-size: 0.9rem; opacity: 0.7; text-decoration: none;"
            aria-label="Escríbenos por WhatsApp"
            onmouseover="this.style.opacity='1'; this.style.color='var(--color-turquesa)'"
            onmouseout="this.style.opacity='0.7'; this.style.color=''"
          >
            WhatsApp
          </a>
        </li>
        <li>
          <a
            href={`mailto:${correo}`}
            class="font-texto text-blanco"
            style="font-size: 0.9rem; opacity: 0.7; text-decoration: none;"
            aria-label={`Enviar correo a ${correo}`}
            onmouseover="this.style.opacity='1'; this.style.color='var(--color-turquesa)'"
            onmouseout="this.style.opacity='0.7'; this.style.color=''"
          >
            {correo}
          </a>
        </li>
        <li>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-texto text-blanco"
            style="font-size: 0.9rem; opacity: 0.7; text-decoration: none;"
            aria-label={`Seguirnos en Instagram: ${instagram}`}
            onmouseover="this.style.opacity='1'; this.style.color='var(--color-turquesa)'"
            onmouseout="this.style.opacity='0.7'; this.style.color=''"
          >
            {instagram}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Divisor -->
  <div
    class="container"
    style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1);"
  >
    <p
      class="font-texto text-blanco"
      style="font-size: 0.8125rem; opacity: 0.45; text-align: center;"
    >
      © {year} {nombre} · {lema}
    </p>
  </div>
</footer>

<style>
  @media (min-width: 640px) {
    .container > div:first-child,
    footer > div.container {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>

